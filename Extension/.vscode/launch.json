{
  "version": "0.2.0",
  "configurations": [
    {
      // Opens the repository root in a second VS Code window that loads this extension from source instead of the
      // installed .vsix. The root has VersePlayground.local.json, which tells the extension where verse.exe is.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.."
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}
