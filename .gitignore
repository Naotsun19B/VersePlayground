# Engine checkout created by Setup.bat
/UnrealEngine/

# Location of verse.exe on this machine, written by Setup.bat
/VersePlayground.local.json

# VS Code extension build output. verse-playground.vsix itself is committed so that users need no Node.js.
/Extension/node_modules/
/Extension/dist/
# Copied from the repository root by every extension build, so that vsce packages it.
/Extension/LICENSE
# Copied from the user's engine checkout at run time; never committed or packaged.
/Extension/syntaxes/

# --- appended by git-workflow:init (generic preset) ---
# Visual Studio user specific files
.vs/

# JetBrains IDE user specific files
.idea/
*.user

# Claude Code
# Everything under .claude/, the code-style overrides included, is local to
# each machine and intentionally not tracked.
.claude/
.mcp.json

# Visual Studio database file
*.VC.db

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# IDE / project files
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
