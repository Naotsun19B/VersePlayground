+// Copyright (c) 2026 Naotsun
+
+// VersePlayground: the .verse files that make up one program. verse.exe compiles every .verse file directly in the
+// folder of the file it runs, and an editor request checks the same files, so that the editor and a run agree.
+
+#pragma once
+
+#include "AutoRTFM.h"
+#include "Containers/Array.h"
+#include "Containers/UnrealString.h"
+#include "ISolarisIde.h"
+#include "Misc/Optional.h"
+#include "Templates/SharedPointer.h"
+
+namespace VerseCmd {
+// The most .verse files that one program may have. A folder of unrelated files, such as a download folder, would
+// otherwise make every run and every editor request compile all of them.
+constexpr int32 MaxProgramFiles = 500;
+
+// The most bytes that the .verse files of one program may add up to, for the same reason.
+constexpr int64 MaxProgramBytes = 32 * 1024 * 1024;
+
+// Lists the names of the .verse files directly in Folder, sorted, as spelled on disk. Subfolders are not searched.
+// Returns false and sets OutError when the folder holds more files or bytes than one program may have.
+[[nodiscard]] AUTORTFM_DISABLE bool ListProgramFiles(const FString& Folder,
+                                                     TArray<FString>& OutNames,
+                                                     FString& OutError);
+
+// Returns the text of a file on disk that starts with a UTF-8 byte order mark, without the mark. Returns an empty
+// optional for any other file, and for one that cannot be read, which the IDE then reads itself. The compiler would
+// count the mark as 3 bytes of the first line, while an editor shows the line without it, so the columns of the
+// first line would not match.
+[[nodiscard]] AUTORTFM_DISABLE TOptional<uLang::CUTF8String> ReadTextWithoutByteOrderMark(const FString& FilePath);
+
+// Adds the file on disk at FilePath to Ide as SourcePath and returns its data source, which the caller must keep until
+// the build ends. A file that starts with a UTF-8 byte order mark is added as its text without the mark, so that the
+// compiler counts the positions as an editor shows them. Any other file is added by its path.
+[[nodiscard]] AUTORTFM_DISABLE TSharedRef<ISolIdeDataSource> AddFileOnDisk(ISolarisIde& Ide,
+                                                                           const FString& FilePath,
+                                                                           uLang::CUTF8String SourcePath);
+
+// Adds the file to run as AddFileOnDisk does, with ScriptFilePath as both the file and the source path.
+[[nodiscard]] AUTORTFM_DISABLE TSharedRef<ISolIdeDataSource> AddScriptSource(ISolarisIde& Ide,
+                                                                             const FUtf8String& ScriptFilePath);
+
+// Adds the other .verse files in the folder of ScriptFilePath and returns their data sources, which the caller must
+// keep until the build ends. Each path is the folder part of ScriptFilePath, up to and including its last '\' or
+// '/', followed by the file name as spelled on disk, so the debugger sees the spelling that the client sends.
+// Prints the reason to stderr and returns an empty optional when the folder cannot be one program.
+[[nodiscard]] AUTORTFM_DISABLE TOptional<TArray<TSharedRef<ISolIdeDataSource>>> AddProgramSources(
+    ISolarisIde& Ide, const FUtf8String& ScriptFilePath);
+}
