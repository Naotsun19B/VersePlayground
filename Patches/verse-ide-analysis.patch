+// Copyright (c) 2026 Naotsun
+
+// VersePlayground: the analysis mode of verse.exe for an editor. "verse --ide-request" reads one request as JSON from
+// stdin and writes the answer as one line of JSON to stdout: the diagnostics of the program in a folder, or the hover
+// text or the definition at a position in one of its files. The program and its build are the same as for a run.
+
+#pragma once
+
+#include "AutoRTFM.h"
+
+namespace VerseCmd {
+// Reads one request from stdin, answers it on stdout, and returns 0 when the answer is ok and 1 otherwise.
+AUTORTFM_DISABLE int RunIdeRequest();
