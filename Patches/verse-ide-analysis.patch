@@ -0,0 +1,129 @@
+// Copyright (c) 2026 Naotsun
+
+#include "ProgramFiles.h"
+#include "Containers/StringConv.h"
+#include "HAL/FileManager.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Paths.h"
+#include "ULangUEUtils.h"
+#include "uLang/SourceProject/SourceDataProject.h"
+#include <stdio.h> // for fprintf
+
+AUTORTFM_DISABLE bool VerseCmd::ListProgramFiles(const FString& Folder, TArray<FString>& OutNames, FString& OutError)
+{
+    OutNames.Reset();
+
+    // The wildcard ignores case, so Main.VERSE belongs to the program as well. Folders named *.verse do not.
+    TArray<FString> Names;
+    IFileManager::Get().FindFiles(Names, *FPaths::Combine(Folder, TEXT("*.verse")), true, false);
+    if (Names.Num() > MaxProgramFiles)
+    {
+        OutError = FString::Printf(TEXT("'%s' has %d .verse files, more than the %d that one program may have."),
+                                   *Folder,
+                                   Names.Num(),
+                                   MaxProgramFiles);
+        return false;
+    }
+
+    int64 TotalBytes = 0;
+    for (const FString& Name : Names)
+    {
+        // FileSize returns -1 for a file deleted since it was listed, which then counts as empty.
+        TotalBytes += FMath::Max<int64>(0, IFileManager::Get().FileSize(*FPaths::Combine(Folder, Name)));
+    }
+    if (TotalBytes > MaxProgramBytes)
+    {
+        OutError = FString::Printf(
+            TEXT("The .verse files in '%s' add up to more than the %lld MB that one program may have."),
+            *Folder,
+            MaxProgramBytes / (1024 * 1024));
+        return false;
+    }
+
+    // FindFiles returns the names in no set order. Sorting them builds the program the same way on every run.
+    Names.Sort();
+    OutNames = MoveTemp(Names);
+    return true;
+}
+
+AUTORTFM_DISABLE TOptional<uLang::CUTF8String> VerseCmd::ReadTextWithoutByteOrderMark(const FString& FilePath)
+{
+    TArray<uint8> Bytes;
+    if (!FFileHelper::LoadFileToArray(Bytes, *FilePath, FILEREAD_Silent) || Bytes.Num() < 3 || Bytes[0] != 0xEF ||
+        Bytes[1] != 0xBB || Bytes[2] != 0xBF)
+    {
+        return {};
+    }
+
+    // The IDE reads the file on disk for an empty text, so a file with only the mark is compiled as one empty line.
+    if (Bytes.Num() == 3)
+    {
+        return uLang::CUTF8String("\n");
+    }
+    return uLang::CUTF8String(uLang::CUTF8StringView(reinterpret_cast<const char*>(Bytes.GetData() + 3),
+                                                     static_cast<size_t>(Bytes.Num() - 3)));
+}
+
+AUTORTFM_DISABLE TSharedRef<ISolIdeDataSource> VerseCmd::AddFileOnDisk(ISolarisIde& Ide,
+                                                                       const FString& FilePath,
+                                                                       uLang::CUTF8String SourcePath)
+{
+    TOptional<uLang::CUTF8String> TextWithoutMark = ReadTextWithoutByteOrderMark(FilePath);
+    if (TextWithoutMark)
+    {
+        return Ide.AddDataSource(
+            uLang::TSRef<uLang::CSourceDataSnippet>::New(MoveTemp(SourcePath), MoveTemp(*TextWithoutMark)));
+    }
+    return Ide.AddDataSource(SourcePath);
+}
+
+AUTORTFM_DISABLE TSharedRef<ISolIdeDataSource> VerseCmd::AddScriptSource(ISolarisIde& Ide,
+                                                                         const FUtf8String& ScriptFilePath)
+{
+    // The source path is ScriptFilePath converted directly, not through FString, so that the debugger sees the
+    // spelling that the client sends.
+    return AddFileOnDisk(Ide, FString(ScriptFilePath), FULangConversionUtils::FUtf8StringToULangStr(ScriptFilePath));
+}
+
+AUTORTFM_DISABLE TOptional<TArray<TSharedRef<ISolIdeDataSource>>> VerseCmd::AddProgramSources(
+    ISolarisIde& Ide, const FUtf8String& ScriptFilePath)
+{
+    // The folder part keeps the separators and the case of ScriptFilePath, and each file name is spelled as on disk.
+    // The debugger compares these paths with the ones that the client sends, which follow the same rule.
+    const FString ScriptPath(ScriptFilePath);
+    int32 SlashIndex = INDEX_NONE;
+    int32 BackslashIndex = INDEX_NONE;
+    ScriptPath.FindLastChar(TEXT('/'), SlashIndex);
+    ScriptPath.FindLastChar(TEXT('\\'), BackslashIndex);
+    const FString FolderPrefix = ScriptPath.Left(FMath::Max(SlashIndex, BackslashIndex) + 1);
+    if (FolderPrefix.IsEmpty())
+    {
+        // main makes the path absolute, so this is never expected. Listing "" would search the working directory,
+        // which UE sets to the engine folder, so the program stays the one file.
+        return TArray<TSharedRef<ISolIdeDataSource>>();
+    }
+
+    TArray<FString> Names;
+    FString Error;
+    if (!ListProgramFiles(FolderPrefix, Names, Error))
+    {
+        fprintf(stderr, "Error: %s\n", TCHAR_TO_UTF8(*Error));
+        return {};
+    }
+
+    // The IDE does not keep the data sources that it is given, so the caller keeps these until the build ends.
+    TArray<TSharedRef<ISolIdeDataSource>> Sources;
+    for (const FString& Name : Names)
+    {
+        const FString Path = FolderPrefix + Name;
+        // BuildScript has already added the file to run.
+        if (FPaths::IsSamePath(Path, ScriptPath))
+        {
+            continue;
+        }
+
+        const FUtf8String Utf8Path(StringCast<UTF8CHAR>(*Path).Get());
+        Sources.Add(AddFileOnDisk(Ide, Path, FULangConversionUtils::FUtf8StringToULangStr(Utf8Path)));
+    }
+    return MoveTemp(Sources);
+}
