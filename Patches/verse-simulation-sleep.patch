@@ -0,0 +1,22 @@
+// Copyright (c) 2026 Naotsun
+
+// VersePlayground: the clock and Sleep of /Verse.org/Simulation for verse.exe, which has no UWorld to provide them.
+
+#pragma once
+
+#include "AutoRTFM.h"
+#include "Templates/Function.h"
+
+namespace verse {
+struct FExecutionContext;
+}
+
+namespace VerseCmd {
+// Starts a frame before each job of the event loop. Updates the time that GetSecondsSinceEpoch and
+// GetSimulationElapsedTime return, which stays the same within a frame.
+AUTORTFM_DISABLE void BeginFrame();
+
+// Returns false when no task is sleeping. Otherwise waits until the sleeping task that is due first is due, and sets
+// OutJob to a job that resumes it.
+AUTORTFM_DISABLE bool WaitForSleepingTask(TFunction<void(const verse::FExecutionContext&)>& OutJob);
+}
